{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "devices": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['name', 'platform', 'lastSeenAtMs', 'revoked']) && newData.child('name').isString() && newData.child('platform').isString() && newData.child('lastSeenAtMs').isNumber() && newData.child('revoked').isBoolean()"
          }
        },
        "projects": {
          "$projectId": {
            ".validate": "newData.hasChildren(['name', 'updatedAtMs', 'deviceId', 'payload']) && newData.child('name').isString() && newData.child('updatedAtMs').isNumber() && newData.child('deviceId').isString() && newData.child('payload').isString()"
          }
        }
      }
    }
  }
}
